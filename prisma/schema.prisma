datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  image     String?
  createdAt DateTime @default(now())

  accounts        Account[]
  sessions        Session[]
  groupMembers    GroupMember[]
  paidExpenses    Expense[]        @relation("PaidBy")
  expenseSplits   ExpenseSplit[]
  settlements     Settlement[]     @relation("Payer")
  settledInto     Settlement[]     @relation("Payee")
  createdGroups   Group[]          @relation("GroupCreator")
  createdInvites  GroupInvite[]    @relation("InviteCreator")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Group {
  id        String   @id @default(cuid())
  name      String
  createdBy String
  createdAt DateTime @default(now())

  creator     User          @relation("GroupCreator", fields: [createdBy], references: [id])
  members     GroupMember[]
  expenses    Expense[]
  invites     GroupInvite[]
  settlements Settlement[]
}

model GroupMember {
  userId   String
  groupId  String
  role     Role     @default(MEMBER)
  joinedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
}

enum Role {
  OWNER
  MEMBER
}

model GroupInvite {
  id        String   @id @default(cuid())
  token     String   @unique
  groupId   String
  createdBy String
  createdAt DateTime @default(now())
  expiresAt DateTime
  used      Boolean  @default(false)

  group   Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  creator User  @relation("InviteCreator", fields: [createdBy], references: [id])
}

model Expense {
  id          String   @id @default(cuid())
  groupId     String
  description String
  totalAmount Decimal  @db.Decimal(12, 2)
  paidBy      String
  createdAt   DateTime @default(now())

  group  Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  payer  User           @relation("PaidBy", fields: [paidBy], references: [id])
  splits ExpenseSplit[]
}

model ExpenseSplit {
  expenseId String
  userId    String
  amount    Decimal @db.Decimal(12, 2)

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@id([expenseId, userId])
}

model Settlement {
  id        String   @id @default(cuid())
  groupId   String
  payerId   String
  payeeId   String
  amount    Decimal  @db.Decimal(12, 2)
  note      String?
  createdAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id])
  payer User  @relation("Payer", fields: [payerId], references: [id])
  payee User  @relation("Payee", fields: [payeeId], references: [id])
}
